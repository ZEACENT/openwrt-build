# Seed config — fed to `make defconfig` by scripts/build.sh.
# Keep it minimal: defconfig resolves everything else from target defaults.

# --- Target: FriendlyARM NanoPi R4S (rockchip / armv8) ---
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_friendlyarm_nanopi-r4s=y

# --- Rootfs size ---
# homeproxy (sing-box) + openclash (mihomo core downloaded at runtime) +
# geodata need far more than the 104 MB default.
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# --- The two LuCI apps (both from the kenzok8/small-package feed) ---
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci=y

# --- openclash needs dnsmasq-full; swap out the base dnsmasq to avoid clash ---
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set

# --- R4S eth1 is a USB3 RTL8153 NIC; make sure its driver is in the image ---
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
